RewriteEngine On

# Error pages
ErrorDocument 404 /404.php

# Block sensitive files
<FilesMatch "\.(env|log|sql|md|gitignore)$">
  Require all denied
</FilesMatch>

# Block directory listing
Options -Indexes

# Disable ModSecurity for voice pages (if mod_security enabled)
<IfModule security2_module>
  <FilesMatch "voice_ai\.(php|js)$">
    SecRuleEngine Off
  </FilesMatch>
</IfModule>

# Cache static assets
<FilesMatch "\.(css|js|ico|svg|woff2)$">
  Header set Cache-Control "max-age=31536000, public"
</FilesMatch>
