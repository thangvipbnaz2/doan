# Sao chép file này thành .env và điền giá trị của bạn
GEMINI_API_KEY=your_gemini_api_key_here
SITE_URL=http://localhost/do-an-tot-nghiep
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
